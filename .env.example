# Environment Configuration for NeuroGuard EEG Seizure Detection
# Copy this file to .env and adjust variables as needed

# Application settings
APP_NAME=NeuroGuard
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Data Paths (Absolute or Relative to project root)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INTERIM_DIR=./data/interim
ARTIFACTS_DIR=./artifacts

# PhysioNet CHB-MIT Dataset URL
CHBMIT_BASE_URL=https://physionet.org/content/chbmit/1.0.0/

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Streamlit Frontend Settings
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000

# MLflow Tracking
MLFLOW_TRACKING_URI=./artifacts/mlruns
MLFLOW_EXPERIMENT_NAME=NeuroGuard_EEG_Seizure_Detection
